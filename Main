#include <iostream>
#include "Board.h"
using namepsace std;

int main()
{

//Objects and variables
Board board;
char playerAnswer = ' ';

//Introduction text
cout << "Welcome to Tic Tac Toe" << endl;
cout << "Here are the rules of the game:" << endl;
cout << "1)	The game only accepts 2 opponents, within a 1 player game mode or a 2 player game mode, whether it be a player vs. player, player vs. computer \n
         2)	The game consists of a 3 by 3 grid, of which each grid is made to hold a reprehensive symbol, (0 or 1) for each player \n
         3)	Players take turns, in alternating order, placing their representative symbol in a grid slot \n
         4)	Players may not override or replace any grid slot that has already been filled with a player’s symbol \n
         5)	Players win the game when 3 grid slots containing the player’s symbols align in a row, column, or diagonal across the 3 by 3 grid. \n";

//Getting player count
cout << "Will you be playing with another person? Y/N: ";
cin >> playerAnswer;

//Making sure input is valid
while (playerAnswer != 'Y' && playerAnswer != 'y' && playerAnswer != 'N' && playerAnswer != 'n')
{
cout << "Sorry, that is an invalid answer. Please enter either 'Y' or 'N' << endl;
cout << "Will you be playing with another person? Y/N: ";
cin >> playerAnswer;
}

if (playerAnswer == 'Y' || playerAnswer == 'y') board.setMultiplayer(true);
else board.setMultiplayer(false);


return 0;
}
